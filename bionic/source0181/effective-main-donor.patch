+// SPDX-License-Identifier: GPL-2.0-or-later
+// Derived from Order c53cd01 ps4_copy.cpp ParallelFor. Unlike deferred jobs,
+// a synchronous join preserves the FEX region-tracker upload transaction.
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <span>
+#include <thread>
+namespace BachataCopy {
+struct Span { std::uint64_t source; std::uint8_t* destination; std::uint64_t size; };
+class Pool {
+public:
+    Pool() : worker([this]{ Loop(); }) {}
+    ~Pool() {
+        { std::lock_guard lock(mutex); stop=true; }
+        ready.notify_all();
+        worker.join();
+    }
+    void Run(std::size_t count, const std::function<void(std::size_t)>& fn) {
+        std::lock_guard serial(run_mutex);
+        {
+            std::lock_guard lock(mutex);
+            task=&fn; limit=count; next=0; done=false; ++generation;
+        }
+        ready.notify_one();
+        Work(fn,count);
+        std::unique_lock lock(mutex);
+        finished.wait(lock,[&]{return done;});
+        task=nullptr;
+    }
+private:
+    void Work(const std::function<void(std::size_t)>& fn,std::size_t count) {
+        for (;;) {
+            auto i=next.fetch_add(1,std::memory_order_relaxed);
+            if (i>=count) break;
+            fn(i);
+        }
+    }
+    void Loop() {
+        std::uint64_t seen=0;
+        for (;;) {
+            std::unique_lock lock(mutex);
+            ready.wait(lock,[&]{return stop || generation!=seen;});
+            if(stop) return;
+            seen=generation;
+            auto* fn=task; const auto count=limit;
+            lock.unlock(); Work(*fn,count); lock.lock();
+            done=true; finished.notify_one();
+        }
+    }
+    std::mutex run_mutex,mutex;
+    std::condition_variable ready,finished;
+    std::atomic_size_t next{0};
+    std::size_t limit{};
+    const std::function<void(std::size_t)>* task{};
+    bool stop{},done{};
+    std::uint64_t generation{};
+    std::thread worker;
+};
+template<class Fn> void Run(std::span<const Span> jobs, Fn fn) {
+    if(jobs.size()<2) {for(const auto& job:jobs) fn(job);return;}
+    static Pool pool;
+    pool.Run(jobs.size(),[&](std::size_t i){fn(jobs[i]);});
+}
+} // namespace BachataCopy
