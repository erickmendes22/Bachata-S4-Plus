+// SPDX-License-Identifier: GPL-2.0-or-later
+// CUSA00552 verified boot profiles from tlou-remastered-android 62ea759.
+// Only worker and frame-timeout groups; no visual changes, watchdog suppression,
+// or donor absolute pointer-range assumption. All guards precede all writes.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <span>
+#include <string_view>
+namespace BachataTlouBoot {
+struct Patch { std::size_t offset; std::string_view expected, replacement; };
+inline constexpr std::array<Patch, 14> v100{{
+    {0x99285A, "c5f82e05b6e47900", "c5f82e0526b55600"},
+    {0x992907, "c5fb100511e47900", "c5fb1005f1a16e00"},
+    {0xEFDD88, "0000a041", ""},
+    {0x107CB00, "0000000000003440", ""},
+    {0x992862, "775a", ""},
+    {0xAACA3A, "7504", "eb04"},
+    {0xAACA65, "7422", "9090"},
+    {0xAABF91, "742d", "9090"},
+    {0xAACA36, "807f5900", ""},
+    {0xAACA40, "4981f8e8030000", ""},
+    {0xAACA61, "80785900", ""},
+    {0xAACA75, "ba0a000000", ""},
+    {0xAABF8D, "807f5900", ""},
+    {0xAABFAF, "e86ca6ffff", ""},
+}};
+inline constexpr std::array<Patch, 7> v111{{
+    {0xB3D887, "c5f82e05819f6300", "c5f82e05194d5c00"},
+    {0xB3D92F, "c5fb1005f19e6300", "c5fb1005a13d5900"},
+    {0x11025A8, "0000a041", ""},
+    {0x10D16D8, "0000000000003440", ""},
+    {0xC87D63, "7304", "eb04"},
+    {0xC87D96, "741b", "9090"},
+    {0xC873E1, "742d", "9090"},
+}};
+inline constexpr int Profile(std::string_view digest) {
+    if (digest == "e5f0aa322f60bd90637cc10d83de08c77885b1921084021c630e04ed3d6febf7") return 100;
+    if (digest == "31f3b0d120803878d10a7184d139c545de334394dd7dd6ca6058a7c995e484a7" ||
+        digest == "3cfa475f88ca68485b6b9230e62b84e195cdbe19e6f7295c110b8dcf8f20884e") return 111;
+    return 0;
+}
+inline constexpr unsigned Nibble(char c) { return c <= '9' ? c - '0' : c - 'a' + 10; }
+inline constexpr std::uint8_t Byte(std::string_view hex, std::size_t i) {
+    return static_cast<std::uint8_t>((Nibble(hex[2*i]) << 4) | Nibble(hex[2*i+1]));
+}
+template<class Mapped>
+bool Apply(int profile, std::span<std::uint8_t> image, Mapped mapped) {
+    const std::span<const Patch> rows = profile == 100 ? std::span<const Patch>{v100} :
+        profile == 111 ? std::span<const Patch>{v111} : std::span<const Patch>{};
+    if (rows.empty()) return false;
+    for (const auto& row : rows) {
+        const auto n = row.expected.size()/2;
+        if (!n || row.offset > image.size() || n > image.size()-row.offset ||
+            (!row.replacement.empty() && row.replacement.size() != row.expected.size()) ||
+            !mapped(row.offset,n)) return false;
+        bool original=true, already=!row.replacement.empty();
+        for (std::size_t i=0;i<n;++i) {
+            original &= image[row.offset+i] == Byte(row.expected,i);
+            if (!row.replacement.empty()) already &= image[row.offset+i] == Byte(row.replacement,i);
+        }
+        if (!original && !already) return false;
+    }
+    for (const auto& row : rows)
+        for (std::size_t i=0;i<row.replacement.size()/2;++i)
+            image[row.offset+i] = Byte(row.replacement,i);
+    return true;
+}
