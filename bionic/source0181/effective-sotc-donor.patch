+// Same GCN shader, exact control table and dispatch bound as the donor.
+static bool ExecuteSotcReplicateHLE(const Shader::Info& info,
+                                   const AmdGpu::ComputeProgram& cs, Rasterizer& rasterizer) {
+    if (!BachataSotcLod::Enabled() || info.buffers.size() < 3 || cs.dim_y != 1 || cs.dim_z != 1)
+        return false;
+    static const bool enabled=[] { const char* v=std::getenv("SOTC_FILL_HLE"); return !v || *v!='0'; }();
+    if (!enabled) return false;
+    auto& cache = rasterizer.GetBufferCache();
+    const auto ctl=info.buffers[0].GetSharp(info);
+    const auto src=info.buffers[1].GetSharp(info);
+    const auto dst=info.buffers[2].GetSharp(info);
+    if ((src.GetStride() && src.GetStride()!=4) || (dst.GetStride() && dst.GetStride()!=4) ||
+        ctl.GetSize()<8 || ctl.base_address>UINT64_MAX-8 || (src.base_address&3) || (dst.base_address&3)) return false;
+    std::array<u32,2> control{};
+    if (!cache.ReadSotcTable(ctl.base_address, control.data(), sizeof(control))) return false;
+    const u64 count = std::min<u64>({control[0],cs.user_data[6],u64(cs.dim_x)*64,dst.GetSize()/4});
+    if (!count) return true;
+    const u64 src_count=control[1]?std::min<u64>(control[1],count):count;
+    const u64 period=src_count*4, size=count*4;
+    const VAddr address=dst.base_address;
+    if (period>src.GetSize() || size>64_MB || address>UINT64_MAX-size || src.base_address>UINT64_MAX-period ||
+        (src.base_address<address+size && address<src.base_address+period) ||
+        (ctl.base_address<address+size && address<ctl.base_address+8)) return false;
+    static thread_local std::vector<u32> table,current;
+    table.resize(count); current.resize(count);
+    if (!cache.ReadSotcTable(src.base_address,table.data(),period) ||
+        !cache.ReadSotcTable(address,current.data(),size)) return false;
+    for (u64 done=src_count; done<count;) {
+        const u64 chunk=std::min(done,count-done);
+        std::memcpy(table.data()+done,table.data(),chunk*4); done+=chunk;
+    }
+    // Skip the whole table if it is already authoritative. Commit a single
+    // validated backing transaction otherwise: an HLE fallback must never
+    // leave only some pages written. Resident GPU seed/fill is still used.
+    if (std::memcmp(table.data(),current.data(),size)==0) return true;
+    return cache.WriteSotcTable(address,table.data(),size,period);
+}
