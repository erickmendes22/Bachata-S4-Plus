+// Adapt the donor's fill-table ownership contract to FEX's physical backing
+// and page-granular dirty bits. Refuse any foreign GPU ownership, including
+// adjacent bytes of a page and image aliases; the original shader then runs.
+bool BufferCache::CanAccessSotcTable(VAddr addr, u64 size) {
+    constexpr u64 limit = 1ULL << 40;
+    if (!size || addr < 0x10000 || addr >= limit || size > limit - addr) return false;
+    const VAddr lo = Common::AlignDown(addr, 4_KB);
+    const VAddr hi = Common::AlignUp(addr + size, 4_KB);
+    return !memory_tracker->IsRegionGpuModified(lo, hi - lo) &&
+           !gpu_modified_ranges.Intersects(lo, hi - lo) &&
+           !texture_cache.HasSotcTableImage(lo, hi - lo);
+}
+
+bool BufferCache::ReadSotcTable(VAddr addr, void* data, u64 size) {
+    return CanAccessSotcTable(addr, size) && memory->TryReadBacking(addr, data, size);
+}
+
+bool BufferCache::WriteSotcTable(VAddr addr, const void* data, u64 size, u64 period) {
+    if (!CanAccessSotcTable(addr, size) || !memory->TryWriteBacking(std::bit_cast<void*>(addr), data, size))
+        return false;
+    MarkReadbacksDirty(addr, size);
+    const u64 first = addr >> block_shift;
+    const u64 last = (addr + size - 1) >> block_shift;
+    bool resident = true;
+    resident_ranges.ForEachGap(first, last + 1, [&](u64, u64) { resident = false; });
+    const Buffer* arena = resident ? address_space[first >> blocks_per_arena_page_shift] : nullptr;
+    if (!arena || arena != address_space[last >> blocks_per_arena_page_shift] ||
+        (addr & 3) || (size & 3) || (period & 3) || !period) {
+        memory_tracker->MarkRegionAsCpuModified(addr, size);
+    } else {
+        // No new sparse bind: keep resident pages alive for the recorded copy.
+        if (IsSotcArena()) for (u64 block=first; block<=last; ++block) block_last_use[block]=use_epoch;
+        const u64 dst = arena->Offset(addr);
+        const auto upload = [&](u64 bytes) {
+            auto staging = staging_pool.Request(bytes, MemoryType::HostUncached);
+            std::memcpy(staging.mapped, data, bytes);
+            staging.Flush();
+            const vk::BufferCopy copy{staging.offset, dst, bytes};
+            runtime.CopyBuffer(staging.buffer, arena, std::span{&copy, 1});
+        };
+        if (period == 4) {
+            u32 value;
+            std::memcpy(&value, data, 4);
+            runtime.FillBuffer(arena, dst, size, value);
+        } else if (period < size) {
+            const u64 seed = std::min(size, period * std::max<u64>(1, 1_MB / period));
+            upload(seed);
+            for (u64 have=seed; have<size;) {
+                const u64 n=std::min(have,size-have);
+                const vk::BufferCopy copy{dst,dst+have,n};
+                runtime.CopyBuffer(arena,arena,std::span{&copy,1});
+                have+=n;
+            }
+        } else upload(size);
+        // Guest backing and the resident GPU arena now contain the same bytes.
+        // Dirty CPU pages remain dirty and will upload the same data as usual.
+    }
+    texture_cache.InvalidateMemory(addr, size);
+    return true;
+}
